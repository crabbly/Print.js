    "@types/webpack": "^5.28.5",
    "@typescript-eslint/eslint-plugin": "^8.0.0-alpha.30",
    "@typescript-eslint/parser": "^8.0.0-alpha.30",
    "babel-loader": "^9.1.3",
    "clean-webpack-plugin": "^4.0.0",
    "coveralls": "3.1.0",
    "css-loader": "^6.10.0",
