{
  "name": "print-js",
  "homepage": "http://printjs.crabbly.com",
  "description": "A tiny javascript library to help printing from the web.",
  "version": "1.6.0",
  "main": "dist/print.js",
  "types": "dist/index.d.ts",
  "repository": "https://github.com/crabbly/Print.js",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "7.11.6",
    "@babel/preset-env": "7.11.5",
    "@types/jasmine": "^5.1.8",
    "@types/karma": "^6.3.9",
    "@types/node": "^22.15.21",
    "@types/webpack": "^5.28.5",
    "@typescript-eslint/eslint-plugin": "~5.62.0",
    "@typescript-eslint/parser": "~5.62.0",
    "babel-loader": "8.1.0",
    "clean-webpack-plugin": "^4.0.0",
    "coveralls": "3.1.0",
    "css-loader": "4.2.2",
    "eslint": "~8.56.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-prettier": "^4.2.1",
    "istanbul-instrumenter-loader": "3.0.1",
    "jasmine-core": "3.6.0",
    "karma": "5.2.1",
    "karma-chrome-launcher": "3.1.0",
    "karma-coverage": "2.0.3",
    "karma-jasmine": "4.0.1",
    "karma-phantomjs-launcher": "1.0.4",
    "karma-sourcemap-loader": "0.3.8",
    "karma-webpack": "4.0.2",
    "mini-css-extract-plugin": "0.11.0",
    "optimize-css-assets-webpack-plugin": "5.0.4",
    "prettier": "~2.8.8",
    "sass": "^1.89.0",
    "sass-loader": "10.0.2",
    "terser-webpack-plugin": "4.1.0",
    "ts-loader": "~8.3.0",
    "typescript": "^5.8.3",
    "webpack": "4.44.1",
    "webpack-cli": "3.3.12",
    "webpack-dev-server": "3.11.0"
  },
  "scripts": {
    "test": "karma start",
    "dev": "webpack --mode development --progress --hide-modules --devtool source-map",
    "watch": "webpack --mode development --watch --progress --hide-modules",
    "production": "webpack --mode production --progress --hide-modules",
    "coverage": "open coverage/lcov-report/index.html",
    "coveralls": "cat coverage/lcov.info | ./node_modules/coveralls/bin/coveralls.js",
    "start": "webpack-dev-server --public http://localhost:8080/test/manual --open",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix"
  },
  "author": "Rodrigo Vieira <rodrigo@crabbly.com>",
  "keywords": [
    "printjs",
    "print.js",
    "print-js"
  ]
}
